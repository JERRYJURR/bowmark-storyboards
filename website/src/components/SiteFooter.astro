---
import Logo from './Logo.astro';
import { FOOTER_NAV } from '../scene/links';
import { HEADLINE_BEATS } from '../scene/content';

// F8 — v5 footer content (FAQ · GitHub · Contact · X · Legal, with Connect and
// Docs; v5's Broadcast is paused), in the redesign's 1024 column. The line under the lock-up
// is the hero's own first headline beat, not new copy.
//
// Sign in points at the external portal only when PUBLIC_SIGN_IN_URL is set;
// until then it is omitted rather than invented.
const signIn: string | undefined = import.meta.env.PUBLIC_SIGN_IN_URL || undefined;
const external = (href: string) => /^https?:/.test(href);
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <a href="/" aria-label="Bowmark AI — home">
        <Logo />
      </a>
      <p class="site-footer__line">{HEADLINE_BEATS[0]}</p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <ul>
        {
          FOOTER_NAV.map((item) => (
            <li>
              <a
                class="site-footer__item"
                href={item.href}
                {...(external(item.href) ? { rel: 'noopener' } : {})}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        {
          signIn && (
            <li>
              <a class="site-footer__item" href={signIn} rel="noopener">
                Sign in
              </a>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</footer>

<style>
  /* a flat step down in tone separates it; no rule */
  .site-footer {
    background: var(--bm-bg-deep);
  }

  .site-footer__inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--bm-space-6);
    width: min(1024px, 100% - 64px);
    margin-inline: auto;
    padding: 72px 0 48px;
  }

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .site-footer__brand > a {
    align-self: flex-start;
    border-radius: var(--bm-radius-btn);
  }

  .site-footer__line {
    font-size: var(--bm-size-micro);
    color: var(--bm-text-meta, rgb(86 85 79 / 0.66));
  }

  .site-footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
    margin: 0 -8px 0 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__item {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 6px 8px;
    border-radius: var(--bm-radius-btn);
    font-size: var(--bm-size-ui-sm);
    color: var(--bm-text-muted);
    transition:
      color var(--bm-dur-fast) var(--bm-ease),
      background var(--bm-dur-fast) var(--bm-ease);
  }

  .site-footer__item:hover {
    color: var(--bm-text);
    background: var(--bm-surface-2);
  }

  .site-footer__item:focus-visible {
    outline-offset: 0;
  }

  /* touch: 44px targets */
  @media (max-width: 820px), (pointer: coarse) {
    .site-footer__item {
      height: 44px;
    }
  }

  @media (max-width: 640px) {
    .site-footer__inner {
      flex-direction: column;
      align-items: stretch;
      width: auto;
      padding: 48px var(--bm-gutter) 40px;
    }

    .site-footer__nav ul {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-inline: -8px;
    }
  }
</style>
