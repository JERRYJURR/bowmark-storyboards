---
import { FAQ, FAQ_TITLE } from '../scene/faq';
import { LINKS } from '../scene/links';

// F6 — "Fair questions." v5's six questions as native <details> disclosures:
// keyboard, screen-reader and no-JS behaviour come from the platform. v5's
// "All questions → /faq" has no page to point at, so the rail offers the live
// docs and the support inbox instead.
//
// No Paper frame exists for this section; it takes the approved frames'
// system: the 44px heading on the 1024 column, then the 221px rail beside the
// 803px column, and rows that open onto the capability wall's faint fill.
---

<section class="f6" id="faq" aria-labelledby="f6-title">
  <span class="bm-anchor" id="f6" aria-hidden="true"></span>

  <h2 class="f6__title" id="f6-title">{FAQ_TITLE}</h2>

  <div class="f6__body">
    <p class="f6__more">
      More in the <a href={LINKS.docs}>docs</a>, or write to{' '}
      <a href={LINKS.support}>{LINKS.supportAddress}</a>.
    </p>

    <div class="f6__list">
      {
        FAQ.map((item) => (
          <details class="f6__item" name="bowmark-faq" id={`faq-${item.id}`} open={item.open}>
            <summary class="f6__q">
              <span>{item.q}</span>
              <span class="f6__icon" aria-hidden="true" />
            </summary>
            <div class="f6__a">
              {item.a.map((para) => (
                <p>
                  {para.map((part) =>
                    typeof part === 'string' ? part : <a href={part.href}>{part.text}</a>
                  )}
                </p>
              ))}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { alignToHash } from '../scene/hash-align';

  const section = document.getElementById('faq');
  const items = Array.from(section?.querySelectorAll<HTMLDetailsElement>('.f6__item') ?? []);
  const animations = new WeakMap<HTMLDetailsElement, Animation>();
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Native <details name> keeps the no-JS accordion exclusive. Enhancement
  // owns the group so outgoing answers can close smoothly instead of snapping.
  for (const item of items) {
    item.removeAttribute('name');
    item.dataset.expanded = String(item.open);
    item.querySelector('summary')?.setAttribute('aria-expanded', String(item.open));
  }

  const setExpanded = (item: HTMLDetailsElement, expanded: boolean, instant = false) => {
    const summary = item.querySelector('summary')!;
    const answer = item.querySelector<HTMLElement>('.f6__a')!;
    const from = item.getBoundingClientRect().height;
    animations.get(item)?.cancel();
    item.dataset.expanded = String(expanded);
    summary.setAttribute('aria-expanded', String(expanded));

    if (instant || reducedMotion.matches) {
      item.open = expanded;
      item.style.height = '';
      item.style.overflow = '';
      return;
    }

    item.open = true;
    const to = summary.getBoundingClientRect().height + (expanded ? answer.getBoundingClientRect().height : 0);
    item.style.overflow = 'clip';
    const animation = item.animate(
      { height: [`${from}px`, `${to}px`] },
      { duration: 260, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
    );
    animations.set(item, animation);
    animation.onfinish = () => {
      if (animations.get(item) !== animation) return;
      item.open = expanded;
      item.style.height = '';
      item.style.overflow = '';
      animations.delete(item);
    };
  };

  const openOnly = (target: HTMLDetailsElement, instant = false) => {
    for (const item of items) {
      const expanded = item === target;
      if ((item.dataset.expanded === 'true') !== expanded) setExpanded(item, expanded, instant);
    }
  };

  for (const item of items) {
    item.querySelector('summary')?.addEventListener('click', (event) => {
      event.preventDefault();
      if (item.dataset.expanded === 'true') setExpanded(item, false);
      else openOnly(item);
    });
  }

  // A link to a specific question (e.g. #faq-cost) opens it.
  const openFromHash = () => {
    const target = window.location.hash.startsWith('#faq-')
      ? document.getElementById(window.location.hash.slice(1))
      : null;
    if (target instanceof HTMLDetailsElement && items.includes(target)) openOnly(target, true);
  };
  openFromHash();
  window.addEventListener('hashchange', openFromHash);

  // Open first, then align: the section and every question (#faq-<id>) stay
  // on target while the islands above hydrate. Each question has its own
  // scroll-margin-top for the fixed header.
  if (section) {
    const questions = Array.from(section.querySelectorAll('details[id]'), (d) => `#${d.id}`);
    alignToHash(section, ['#faq', '#f6', ...questions]);
  }
</script>

<style>
  .f6 {
    --f6-meta: var(--bm-text-meta, rgb(86 85 79 / 0.66));
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    padding: 104px 32px 112px;
    scroll-margin-top: var(--bm-header-h);
  }

  .f6__title {
    width: min(1024px, 100%);
    font-size: var(--bm-size-h2);
    font-weight: var(--bm-weight-head);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .f6__body {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 48px;
    width: min(1024px, 100%);
  }

  .f6__more {
    flex: 0 0 221px;
    position: sticky;
    top: calc(var(--bm-header-h) + 40px);
    padding: 8px;
    font-size: var(--bm-size-micro);
    line-height: 1.5;
    color: var(--f6-meta);
  }

  .f6 a {
    color: var(--bm-text-muted);
    text-decoration: underline;
    text-decoration-color: var(--bm-underline);
    text-underline-offset: 3px;
    transition:
      color var(--bm-dur-fast) var(--bm-ease),
      text-decoration-color var(--bm-dur-fast) var(--bm-ease);
  }

  .f6 a:hover {
    color: var(--bm-text);
    text-decoration-color: var(--bm-text);
  }

  .f6__list {
    flex: 0 1 803px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .f6__item {
    border-radius: 10px;
    scroll-margin-top: calc(var(--bm-header-h) + 16px);
    transition: background var(--bm-dur-base) var(--bm-ease);
  }

  .f6__item:hover {
    background: var(--bm-surface-1);
  }

  .f6__item[data-expanded='true'],
  .f6__item[open]:not([data-expanded]) {
    background: var(--bm-surface-2);
  }

  .f6__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 52px;
    padding: 14px 16px;
    border-radius: 10px;
    font-size: var(--bm-size-body);
    line-height: 1.4;
    color: var(--bm-text-nav);
    list-style: none;
    cursor: pointer;
    transition: color var(--bm-dur-fast) var(--bm-ease);
  }

  .f6__q::-webkit-details-marker {
    display: none;
  }

  .f6__q:hover,
  .f6__item[data-expanded='true'] .f6__q {
    color: var(--bm-text);
  }

  .f6__q:focus-visible {
    outline-offset: -2px;
    border-radius: 10px;
  }

  /* plus that turns into a minus — the mark alone, no disc behind it */
  .f6__icon {
    position: relative;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .f6__icon::before,
  .f6__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 11px;
    height: 1.5px;
    border-radius: 1px;
    background: var(--bm-text-faint);
    transform: translate(-50%, -50%);
    transition:
      transform var(--bm-spring-dur) var(--bm-spring),
      background var(--bm-dur-base) var(--bm-ease);
  }

  .f6__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .f6__item[data-expanded='true'] .f6__icon::before,
  .f6__item[data-expanded='true'] .f6__icon::after {
    background: var(--bm-text);
  }

  .f6__item[data-expanded='true'] .f6__icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .f6__a {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 62ch;
    padding: 0 16px 18px;
    font-size: var(--bm-size-ui);
    line-height: 1.6;
    color: var(--bm-text-muted);
  }

  @media (max-width: 820px) {
    .f6 {
      gap: 24px;
      padding: var(--bm-space-8) var(--bm-gutter);
    }

    .f6__body {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
    }

    .f6__more {
      flex: none;
      position: static;
      padding: 0 16px;
    }

    .f6__list {
      flex: none;
    }
  }

  @media (max-width: 480px) {
    .f6__q {
      padding: 13px 14px;
      font-size: 16px;
    }

    .f6__a {
      padding: 0 14px 16px;
    }
  }
</style>
