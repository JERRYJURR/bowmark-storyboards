---
import Logo from './Logo.astro';
import { HEADER_MENU, HEADER_NAV, LINKS } from '../scene/links';

// Paper redesign header: one floating 580×40 pill, 16px from the top and
// centred, shared by every frame. Left: the lock-up, Docs (Paper's Broadcast
// link is paused with its section). A
// hairline. Right: Sign in (only when PUBLIC_SIGN_IN_URL is configured) and
// Get started. The left group takes the slack, so the pill keeps its width
// with or without Sign in.
//
// Below 641px the pill spans the viewport, the text links fold into a
// disclosure menu (which also keeps FAQ and GitHub from the previous header),
// and Get started stays visible.
const signIn = LINKS.signIn;
---

<header class="site-header" data-menu="closed">
  <div class="site-header__bar bm-float">
    <div class="site-header__start">
      <a class="site-header__item site-header__brand" href="/" aria-label="Bowmark AI — home">
        <Logo />
      </a>

      <nav class="site-nav" aria-label="Primary">
        {
          HEADER_NAV.map((item) => (
            <a class="site-header__item" href={item.href}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>

    <span class="site-header__rule" aria-hidden="true"></span>

    <div class="site-header__end">
      {
        signIn && (
          <a class="site-header__item site-header__signin" href={signIn}>
            Sign in
          </a>
        )
      }
      <a class="bm-btn bm-btn--cta site-header__cta" href={LINKS.getStarted}>Get started</a>

      <button
        type="button"
        class="site-header__toggle"
        aria-expanded="false"
        aria-controls="site-menu"
        data-menu-toggle
      >
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
          <path class="site-header__line site-header__line--top" d="M3.5 7h13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          <path class="site-header__line site-header__line--bottom" d="M3.5 13h13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav class="site-menu bm-float" id="site-menu" aria-label="Primary (mobile)" hidden>
    {
      HEADER_MENU.map((item) => (
        <a class="site-menu__item" href={item.href}>
          {item.label}
          {item.external && (
            <svg viewBox="0 0 12 12" width="11" height="11" aria-hidden="true" focusable="false">
              <path d="M4 2.5h5.5V8M9.5 2.5 3 9" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
            </svg>
          )}
        </a>
      ))
    }
    {
      signIn && (
        <a class="site-menu__item" href={signIn}>
          Sign in
        </a>
      )
    }
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = header?.querySelector<HTMLElement>('#site-menu');

  if (header && toggle && menu) {
    const setOpen = (open: boolean, refocus = false) => {
      toggle.setAttribute('aria-expanded', String(open));
      header.dataset.menu = open ? 'open' : 'closed';
      menu.hidden = !open;
      if (!open && refocus) toggle.focus();
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

    // Following a link closes the menu (in-page anchors do not reload).
    menu.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) setOpen(false, true);
    });

    document.addEventListener('pointerdown', (e) => {
      if (!menu.hidden && !header.contains(e.target as Node)) setOpen(false);
    });

    // Back to the full pill: the inline nav returns, the menu must not linger.
    window.matchMedia('(min-width: 641px)').addEventListener('change', (mq) => {
      if (mq.matches) setOpen(false);
    });

    // The portrait story owns the floating header. Let the pill leave with
    // its final viewport so the compact closing-section headings stay clear.
    const story = document.getElementById('b1-track');
    if (story) {
      const portrait = window.matchMedia('(max-width: 860px)');
      let frame = 0;
      const updateStoryHeader = () => {
        frame = 0;
        const bottom = story.getBoundingClientRect().bottom;
        const top = parseFloat(getComputedStyle(header).top);
        const travel = header.offsetHeight + top;
        const y = portrait.matches ? Math.max(-travel, Math.min(0, bottom - travel)) : 0;
        // Scroll positions can stop a fraction of a CSS pixel before the
        // section edge. A fully departed pill must also leave the tab order.
        const hidden = portrait.matches && bottom <= 1;
        header.style.setProperty('--bm-header-story-y', `${y}px`);
        header.dataset.storyVisible = hidden ? '0' : '1';
        header.inert = hidden;
        if (hidden && !menu.hidden) setOpen(false);
      };
      const schedule = () => {
        if (!frame) frame = requestAnimationFrame(updateStoryHeader);
      };
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule);
      portrait.addEventListener('change', schedule);
      new ResizeObserver(schedule).observe(story);
      updateStoryHeader();
    }
  }
</script>

<style>
  /* The header box itself is transparent and click-through; only the pill
     and the open menu take pointer events. */
  .site-header {
    position: fixed;
    top: var(--bm-nav-top);
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--bm-space-2);
    padding-inline: var(--bm-space-3);
    pointer-events: none;
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    gap: var(--bm-space-4);
    width: min(var(--bm-nav-w), 100%);
    height: var(--bm-nav-h);
    padding: 4px;
    pointer-events: auto;
  }

  .site-header__start {
    display: flex;
    align-items: center;
    flex: 1;
    min-width: 0;
    gap: var(--bm-space-2);
  }

  .site-nav,
  .site-header__end {
    display: flex;
    align-items: center;
    gap: var(--bm-space-2);
  }

  .site-header__end {
    flex-shrink: 0;
  }

  /* Paper nav item: 6px × 10px around 14/20 muted text, 8px radius. */
  .site-header__item {
    display: inline-flex;
    align-items: center;
    padding: 6px 10px;
    border-radius: var(--bm-radius-btn);
    font-size: 14px;
    line-height: 20px;
    color: var(--bm-text-muted);
    white-space: nowrap;
    transition:
      color var(--bm-dur-fast) var(--bm-ease),
      background var(--bm-dur-fast) var(--bm-ease);
  }

  .site-header__item:hover {
    color: var(--bm-text);
    background: var(--bm-control-fill);
  }

  .site-header__brand {
    padding-block: 6px;
  }

  .site-header__rule {
    flex-shrink: 0;
    width: 1px;
    height: 24px;
    background: var(--bm-line);
  }

  .site-header__toggle {
    display: none;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: var(--bm-radius-btn);
    background: transparent;
    color: var(--bm-text-nav);
    cursor: pointer;
  }

  .site-header__toggle:hover {
    background: var(--bm-control-fill);
  }

  .site-header__line {
    transform-origin: 10px 10px;
    transition: transform var(--bm-spring-dur) var(--bm-spring);
  }

  .site-header[data-menu='open'] .site-header__line--top {
    transform: translateY(3px) rotate(45deg);
  }

  .site-header[data-menu='open'] .site-header__line--bottom {
    transform: translateY(-3px) rotate(-45deg);
  }

  /* --- phone menu: a second floating panel under the pill ---------------- */

  .site-menu {
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: min(var(--bm-nav-w), 100%);
    padding: 4px;
    pointer-events: auto;
  }

  .site-menu[hidden] {
    display: none;
  }

  .site-menu__item {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 12px;
    border-radius: var(--bm-radius-sm);
    font-size: var(--bm-size-ui);
    color: var(--bm-text-nav);
  }

  .site-menu__item svg {
    color: var(--bm-text-faint);
  }

  .site-menu__item:hover {
    background: var(--bm-control-fill);
    color: var(--bm-text);
  }

  @media (max-width: 860px) {
    .site-header {
      transform: translateY(var(--bm-header-story-y, 0px));
    }

    .site-header[data-story-visible='0'] {
      visibility: hidden;
    }
  }

  /* Phone: the pill grows from 40 to 52px so the lock-up, Get started and the
     menu toggle each get a 44px box; they sit side by side with 8px gaps, so
     no hit areas overlap. Desktop keeps Paper's 580×40 exactly. */
  @media (max-width: 640px) {
    .site-header__bar {
      gap: var(--bm-space-2);
      height: 52px;
    }

    .site-header__item,
    .site-header__cta {
      min-height: 44px;
      height: 44px;
    }

    .site-header__toggle {
      width: 44px;
      height: 44px;
    }

    .site-nav,
    .site-header__signin,
    .site-header__rule {
      display: none;
    }

    .site-header__toggle {
      display: grid;
    }
  }

  @media (min-width: 641px) {
    .site-menu {
      display: none !important;
    }
  }
</style>
